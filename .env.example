# Just Easy CA Classes platform runtime configuration

# Core backend
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://app_user:replace-me@postgres:5432/just_easy_ca?schema=public&sslmode=require
JWT_SECRET=replace-with-at-least-48-random-characters
APP_URL=https://app.example.com
API_BASE_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
TRUST_PROXY_HOPS=1
COOKIE_SAME_SITE=lax
LOG_LEVEL=INFO
ALLOW_SELF_ENROLLMENT=false
CRON_TIMEZONE=Asia/Kolkata

# Transactional email — Resend HTTP API is the primary transport.
# RESEND_FROM_EMAIL must be an address on the domain you verified in Resend
# (SPF, DKIM and DMARC records published), otherwise every send is rejected.
RESEND_API_KEY=re_replace-me
RESEND_FROM_EMAIL=no-reply@justeasycaclasses.com
RESEND_FROM_NAME=Just Easy CA Classes
SUPPORT_EMAIL=hello@justeasycaclasses.com
GRIEVANCE_EMAIL=grievance@justeasycaclasses.com

# Optional SMTP fallback, used only if a Resend send fails. Leave EMAIL_HOST
# blank to disable it and rely on Resend alone.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Email verification and sign-in codes.
# SEND_VERIFICATION_EMAILS only affects the legacy verification-link fallback.
SEND_VERIFICATION_EMAILS=true
# Offers students "email me a code" as an alternative to their password. Staff
# accounts (admin, super admin, teacher, assistant) are always password-only.
# Set to false during an email provider outage to hide the option; password
# sign-in and registration codes are unaffected.
LOGIN_OTP_ENABLED=true

# LiveKit SFU. Use separate credentials for local, staging, and production.
LIVEKIT_API_URL=https://live.example.com
LIVEKIT_WS_URL=wss://live.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_MAX_PARTICIPANTS=300
LIVEKIT_STUDENTS_CAN_PUBLISH=false

# Storage: local is development-only; production must use azure or s3.
STORAGE_DRIVER=azure

# Optional fictional payment details for local demonstrations only.
# Production payment details must be entered by an administrator in System Settings.
DEMO_PAYMENT_ACCOUNT_NAME=Just Easy Academy Demo Account
DEMO_PAYMENT_ACCOUNT_NUMBER=000000000000
DEMO_PAYMENT_IFSC=DEMO0000001
DEMO_PAYMENT_UPI=demo@upi
DEMO_PAYMENT_INSTRUCTIONS=DEMO ONLY - do not transfer real money.

# Azure Blob storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_PUBLIC_CONTAINER=public-assets
AZURE_PRIVATE_CONTAINER=private-content

# AWS S3 storage. ECS uses its task role; static access keys are only for local testing.
AWS_REGION=ap-south-1
AWS_PUBLIC_S3_BUCKET_NAME=
AWS_PRIVATE_S3_BUCKET_NAME=
PUBLIC_ASSET_BASE_URL=

# Frontend runtime configuration (container environment)
API_URL=https://api.example.com
RELEASE=git-sha
COMPANY_LEGAL_NAME=Just Easy CA Classes Private Limited
LEGAL_ADDRESS=
SUPPORT_PHONE=+91 8894357155
GRIEVANCE_OFFICER_NAME=
CIN=
GSTIN=
REQUIRE_LEGAL_CONFIG=true
