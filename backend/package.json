{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npx prisma generate && tsx watch --require dotenv/config src/server.ts",
    "start": "node dist/server.js",
    "build": "rimraf dist && tsc && tsc-alias -p tsconfig.json && npm run copy:assets",
    "copy:assets": "node -e \"const fs=require('fs'),p=require('path');const s='src/utils/assets',d='dist/utils/assets';fs.cpSync(s,d,{recursive:true});console.log('copied assets')\"",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:seed": "node -r dotenv/config seed.js",
    "db:seed:demo": "node -r dotenv/config seed-demo.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@azure/storage-blob": "^12.33.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "fast-csv": "^5.0.7",
    "helmet": "^8.2.0",
    "json2csv": "6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.17.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.17.2",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "stream-buffers": "^3.0.3",
    "uuid": "^13.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/stream-buffers": "^3.0.8",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.23.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.2.6"
  }
}
